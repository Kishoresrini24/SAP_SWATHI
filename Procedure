PROCEDURE "IRRBB_MI_SCB_STABLE_BALANCE_PROC" (IN IP_REPORTING_DATE DATE,
                                              IN IP_WORKSPACE_NAME NVARCHAR(250),
											  IN IP_WRAP_PROC_SYSUUID NVARCHAR(100))

   LANGUAGE SQLSCRIPT
   SQL SECURITY INVOKER
AS BEGIN



 
DECLARE ZVAR_DATAPRODUCT NVARCHAR (5000);
DECLARE ZVAR_PROCESSING_DATE DATE;
DECLARE ZVAR_REPORTING_DATE DATE;
DECLARE ZVAR_STG_TABLE NVARCHAR(150);
DECLARE ZVAR_STG_PUSH_START_TIMESTAMP TIMESTAMP;
DECLARE ZVAR_STG_PUSH_END_TIMESTAMP TIMESTAMP;
DECLARE ZVAR_STG_PROCESSING_STATUS NVARCHAR(150);
DECLARE ZVAR_STG_REC_CNT INTEGER;
DECLARE ZVAR_HC_LOAD_START TIMESTAMP;
DECLARE ZVAR_HC_LOAD_END TIMESTAMP;
DECLARE ZVAR_HC_TOTAL_LOAD_TIME nvarchar(20);
DECLARE ZVAR_RECORD_COUNT INTEGER;
DECLARE ZVAR_RECORD_COUNT_REMOTE INTEGER;
DECLARE ZVAR_RECORDS_STATUS NVARCHAR(1000);
DECLARE SQL_ERROR_CODE NVARCHAR(250);
DECLARE ZVAR_ERR_CODE NVARCHAR(250);
DECLARE ZVAR_ERR_MSG NVARCHAR(250);
DECLARE ZVAR_WORKSPACE_NAME NVARCHAR(150);
DECLARE MAXTIME_ER TIMESTAMP;
DECLARE SQL_ERROR_MESSAGE NVARCHAR(250);
DECLARE ZVAR_PHY_TABLE NVARCHAR(150) := 'IRRBB_SCB_DATA_STABLE_BALANCE_T';
DECLARE MAXTIME TIMESTAMP;
DECLARE i INTEGER;
DECLARE lv_count INTEGER;
DECLARE ZVAR_HC_STG_TABLE NVARCHAR(150);
DECLARE ZVAR_FILE_TYPE NVARCHAR(50);
DECLARE lv_proc_name VARCHAR(256);

DECLARE V_SOURCE_COUNT, V_TARGET_COUNT ,V_DELETED_COUNT , V_INSERTED_COUNT INTEGER := 0 ;
DECLARE V_SYSUID VARCHAR(150) =  TO_VARCHAR(SYSUUID);
DECLARE V_START_TIME TIMESTAMP = CURRENT_TIMESTAMP;
DECLARE V_PROC_NAME NVARCHAR(100) = ::CURRENT_OBJECT_NAME;
DECLARE V_STG_TB VARCHAR(50) = 'IRRBB_SCB_DATA_STABLE_BALANCE_STG_T';
DECLARE V_TGT_TB VARCHAR(50) = 'IRRBB_SCB_DATA_STABLE_BALANCE_T';
DECLARE V_TIME_DIFF INTEGER;
DECLARE V_WORKSTREAM NVARCHAR(13) := 'IRRBB';
DECLARE V_METRIC NVARCHAR(150) := 'IRRBB_MI_STABLE_BAL';
DECLARE V_USER NVARCHAR(150) := current_user;
DECLARE V_DATA_LAYER NVARCHAR(100);
DECLARE V_STEP INTEGER := 0;
DECLARE V_FROM_REPORTING_DATE DATE ;
DECLARE V_TO_REPORTING_DATE DATE ;
  
 
--Exception Handling
DECLARE EXIT HANDLER FOR SQLEXCEPTION
    BEGIN 
        --Capture Error
        SELECT ::SQL_ERROR_CODE,::SQL_ERROR_MESSAGE FROM "IRRBB_DUMMY_SYN";
	--SQL_ERROR_CODE    := ::SQL_ERROR_CODE;
	--SQL_ERROR_MESSAGE := ::SQL_ERROR_MESSAGE;
        INSERT INTO "IRRBB_ERROR_LOG_T_SYN" ----IRRBB_ERROR_LOG_T is created in PHY system and synonym is created in LOG system
        VALUES(ZVAR_DATAPRODUCT,::SQL_ERROR_CODE,::SQL_ERROR_MESSAGE,CURRENT_TIMESTAMP);
    
    CALL "IRRBB_PROC_INS_RUN_LOG"
(   'SCHEDULED>'||current_timestamp,
    'IRRBB',
    :IP_REPORTING_DATE,
    'SCHEDULED',
    'AS AND WHEN COUNTRY ARRIVES IN STARS',
    'FINAL',
    'IRRBB_MI_SCB_STABLE_BALANCE_PROC',
    'T1TREASURYIRRBB_LOG',
    'IRRBB_SCB_DATA_STABLE_BALANCE_T',
    'FACT',
    'FAILED',
    :ZVAR_RECORD_COUNT,
    ::SQL_ERROR_CODE,
    ::SQL_ERROR_MESSAGE,
	SECONDS_BETWEEN(:ZVAR_HC_LOAD_START,CURRENT_TIMESTAMP)--:ZVAR_HC_TOTAL_LOAD_TIME
);

CALL TRA_IRRBB_LOAD_LOG_PROC
( IP_WORKSTREAM => :V_WORKSTREAM,
	IP_METRIC => :V_METRIC,
	IP_WRAPPER_PROC_SYSUID => :IP_WRAP_PROC_SYSUUID,
	IP_PROC_SYSUID => :V_SYSUID,
	IP_WRAPPER_PROC_NAME => 'IRRBB_CTRLM_WRAPPER_PROC',
	IP_PROC_CTRLM_NAME => :V_PROC_NAME, 
	IP_REPORTING_DATE_START => :IP_REPORTING_DATE,
	IP_REPORTING_DATE_END => :IP_REPORTING_DATE,
	IP_ENTITY => 'NA',
	IP_ADDITIONAL_IP => 'NA',
	IP_DATA_LAYER => :V_DATA_LAYER,
	IP_SRC_TABLE =>:V_STG_TB,
	IP_TGT_TABLE =>:V_TGT_TB,
	IP_SRC_COUNT =>:V_SOURCE_COUNT,
	IP_TGT_COUNT => :V_TARGET_COUNT, 
	IP_ROWCOUNT => :V_DELETED_COUNT,
	IP_START_TIMESTAMP => :V_START_TIME,
	IP_END_TIMESTAMP => CURRENT_TIMESTAMP,
	IP_LOAD_STATUS => 	'FAILED',
	IP_ERROR_CODE => NULL,
	IP_ERROR_MESSAGE => NULL,
	IP_STEP_NUM => :V_STEP,
	IP_STEP_DESC =>  'ERROR',
	IP_STEP_DETAILS => 'ERROR',
	IP_IDENTIFIER => 'ERROR',
	IP_CURRENT_USER => :V_USER);

	COMMIT;

    END;

    V_DATA_LAYER = 'AGG';
	V_STEP = V_STEP + 1;
 
ZVAR_DATAPRODUCT = 'IRRBB_MI_SCB_STABLE_BAL';
ZVAR_HC_LOAD_START = CURRENT_TIMESTAMP;

select count(*) INTO ZVAR_RECORD_COUNT_REMOTE from "IRRBB_SCB_DATA_STABLE_BALANCE_STG_T_SYN"
WHERE W_REPORTING_DATE = IP_REPORTING_DATE
and W_WORKSPACE_NAME = IP_WORKSPACE_NAME;

CALL TRA_IRRBB_LOAD_LOG_PROC
( 	IP_WORKSTREAM => :V_WORKSTREAM,
	IP_METRIC => :V_METRIC,
	IP_PROC_SYSUID => :V_SYSUID,
	IP_WRAPPER_PROC_NAME => 'IRRBB_CTRLM_WRAPPER_PROC',
	IP_PROC_CTRLM_NAME => :V_PROC_NAME, 
	IP_REPORTING_DATE_START => :IP_REPORTING_DATE,
	IP_REPORTING_DATE_END => :IP_REPORTING_DATE,
	IP_ENTITY => 'NA',
	IP_ADDITIONAL_IP => 'NA',
	IP_DATA_LAYER => :V_DATA_LAYER,
	IP_SRC_TABLE =>:V_STG_TB,
	IP_TGT_TABLE =>:V_TGT_TB,
	IP_SRC_COUNT => 0,
	IP_TGT_COUNT => 0, 
	IP_ROWCOUNT => 0,
	IP_START_TIMESTAMP => :V_START_TIME,
	IP_END_TIMESTAMP => CURRENT_TIMESTAMP,
	IP_LOAD_STATUS => 	'IN PROGRESS',
	IP_ERROR_CODE => NULL,
	IP_ERROR_MESSAGE => NULL,
	IP_STEP_NUM => :V_STEP,
	IP_STEP_DESC =>  'Started the procedure execution',
	IP_STEP_DETAILS => NULL,
	IP_IDENTIFIER => 'START',
	IP_CURRENT_USER => :V_USER);

IF ZVAR_RECORD_COUNT_REMOTE != 0 
   THEN

CALL "IRRBB_PROC_INS_RUN_LOG"
(   'SCHEDULED>'||current_timestamp,
    'IRRBB',
    :IP_REPORTING_DATE,
    'SCHEDULED',
    'AS AND WHEN COUNTRY ARRIVES IN STARS',
    'STEP-1',
    'IRRBB_MI_SCB_STABLE_BALANCE_PROC',
    'T1TREASURYIRRBB_LOG',
    'IRRBB_SCB_DATA_STABLE_BALANCE_T',
    'FACT',
    'S',
     0,
    'Truncating table "IRRBB_SCB_DATA_STABLE_BALANCE_T"',
     NULL,
     0
);
   --Truncating Table
   DELETE FROM "IRRBB_SCB_DATA_STABLE_BALANCE_T_SYN"
   WHERE W_REPORTING_DATE = IP_REPORTING_DATE
   and W_WORKSPACE_NAME = IP_WORKSPACE_NAME;

V_DELETED_COUNT := ::ROWCOUNT;
V_STEP = V_STEP + 1; 

CALL TRA_IRRBB_LOAD_LOG_PROC
( 	IP_WORKSTREAM => :V_WORKSTREAM,
	IP_METRIC => :V_METRIC,
	IP_PROC_SYSUID => :V_SYSUID,
	IP_WRAPPER_PROC_NAME => 'IRRBB_CTRLM_WRAPPER_PROC',
	IP_PROC_CTRLM_NAME => :V_PROC_NAME, 
	IP_REPORTING_DATE_START => :IP_REPORTING_DATE,
	IP_REPORTING_DATE_END => :IP_REPORTING_DATE,
	IP_ENTITY => 'NA',
	IP_ADDITIONAL_IP => 'NA',
	IP_DATA_LAYER => 'AGG',
	IP_SRC_TABLE =>:V_STG_TB,
	IP_TGT_TABLE =>:V_TGT_TB,
	IP_SRC_COUNT =>:V_SOURCE_COUNT,
	IP_TGT_COUNT => :V_TARGET_COUNT, 
	IP_ROWCOUNT => :V_DELETED_COUNT,
	IP_START_TIMESTAMP => :V_START_TIME,
	IP_END_TIMESTAMP => CURRENT_TIMESTAMP,
	IP_LOAD_STATUS => 	'SUCCESS',
	IP_ERROR_CODE => NULL,
	IP_ERROR_MESSAGE => NULL,
	IP_STEP_NUM => :V_STEP,
	IP_STEP_DESC =>  'Deleting existing records before insert',
	IP_STEP_DETAILS => NULL,
	IP_IDENTIFIER => 'DELETE',
	IP_CURRENT_USER => :V_USER);
   
CALL "IRRBB_PROC_INS_RUN_LOG"
(   'SCHEDULED>'||current_timestamp,
    'IRRBB',
    :IP_REPORTING_DATE,
    'SCHEDULED',
    'AS AND WHEN COUNTRY ARRIVES IN STARS',
    'STEP-2',
    'IRRBB_MI_SCB_STABLE_BALANCE_PROC',
    'T1TREASURYIRRBB_LOG',
    'IRRBB_SCB_DATA_STABLE_BALANCE_T',
    'FACT',
    'S',
     0,
    'Started the loading of table "IRRBB_SCB_DATA_STABLE_BALANCE_T"',
     NULL,
     0
);

   --Load Data from stage table to  to HC_Table
   INSERT INTO "IRRBB_SCB_DATA_STABLE_BALANCE_T_SYN" (
      "PARTITION_KEY",
	"MONTHEND_REPORTING_DATE",
	"COUNTRY_CODE",
	"ACCOUNT_TYPE",
	"CURRENCY",
	"BOOK_CODE",
	"TOTAL_BALANCE",
	"AVERAGE_BALANCE",
	"STABLE_PERCENTAGE",
	"STABLE_BALANCE",
	"COUNT_REPORTING_DAYS",
	"W_COUNTRY_CODE",
	"W_BATCH_ID",
	"W_DATASOURCE_ID",
	"W_REFRESH_DT",
	"W_CONTEXT_POSITION",
	"W_SUBPART_KEY",
	"W_REPORTING_DATE",
	"W_WORKSPACE_NAME")
	
  SELECT 
	 "PARTITION_KEY",
	"MONTHEND_REPORTING_DATE",
	"COUNTRY_CODE",
	"ACCOUNT_TYPE",
	"CURRENCY",
	"BOOK_CODE",
	CAST("TOTAL_BALANCE" AS DECIMAL(36,8)) AS TOTAL_BALANCE,
	CAST("AVERAGE_BALANCE" AS DECIMAL(36,8)) AS AVERAGE_BALANCE,
	CAST("STABLE_PERCENTAGE" AS DECIMAL(36,8)) AS STABLE_PERCENTAGE,
	CAST("STABLE_BALANCE" AS DECIMAL(36,8)) AS STABLE_BALANCE,
	"COUNT_REPORTING_DAYS",
	"W_COUNTRY_CODE",
	"W_BATCH_ID",
	"W_DATASOURCE_ID",
	"W_REFRESH_DT",
	"W_CONTEXT_POSITION",
	"W_SUBPART_KEY",
	"W_REPORTING_DATE",
	"W_WORKSPACE_NAME"
FROM "IRRBB_SCB_DATA_STABLE_BALANCE_STG_T_SYN"
WHERE W_REPORTING_DATE = IP_REPORTING_DATE
   and W_WORKSPACE_NAME = IP_WORKSPACE_NAME;
 
ELSE
     INSERT INTO "IRRBB_ERROR_LOG_T_SYN" 
      VALUES(ZVAR_DATAPRODUCT,'No_Records','NO RECORDS IN HIVE_DB',CURRENT_TIMESTAMP);
END IF;
select count(*) INTO ZVAR_RECORD_COUNT from "IRRBB_SCB_DATA_STABLE_BALANCE_T_SYN"
WHERE W_REPORTING_DATE = IP_REPORTING_DATE
   and W_WORKSPACE_NAME = IP_WORKSPACE_NAME;

ZVAR_HC_LOAD_END = CURRENT_TIMESTAMP;

V_INSERTED_COUNT := ::ROWCOUNT;
V_STEP = V_STEP + 1;

CALL TRA_IRRBB_LOAD_LOG_PROC
( 	IP_WORKSTREAM => :V_WORKSTREAM,
	IP_METRIC => :V_METRIC,
	IP_PROC_SYSUID => :V_SYSUID,
	IP_WRAPPER_PROC_NAME => 'IRRBB_CTRLM_WRAPPER_PROC',
	IP_PROC_CTRLM_NAME => :V_PROC_NAME, 
	IP_REPORTING_DATE_START => :IP_REPORTING_DATE,
	IP_REPORTING_DATE_END => :IP_REPORTING_DATE,
	IP_ENTITY => 'NA',
	IP_ADDITIONAL_IP => 'NA',
	IP_DATA_LAYER => 'AGG',
	IP_SRC_TABLE =>:V_STG_TB,
	IP_TGT_TABLE =>:V_TGT_TB,
	IP_SRC_COUNT =>:V_SOURCE_COUNT,
	IP_TGT_COUNT => :ZVAR_RECORD_COUNT, 
	IP_ROWCOUNT => :V_INSERTED_COUNT,
	IP_START_TIMESTAMP => :V_START_TIME,
	IP_END_TIMESTAMP => CURRENT_TIMESTAMP,
	IP_LOAD_STATUS => 	'SUCCESS',
	IP_ERROR_CODE => NULL,
	IP_ERROR_MESSAGE => NULL,
	IP_STEP_NUM => :V_STEP,
	IP_STEP_DESC =>  'Completed Data Loading',
	IP_STEP_DETAILS => 'Records Inserted',
	IP_IDENTIFIER => 'INSERT',
	IP_CURRENT_USER => :V_USER);
 
--Calculating time difference 
ZVAR_HC_TOTAL_LOAD_TIME = substr_before(cast(floor((seconds_between(ZVAR_HC_LOAD_START,ZVAR_HC_LOAD_END)/3600) ) as nvarchar),'.')
|| ':' ||
substr_before(cast(floor( mod( (seconds_between(ZVAR_HC_LOAD_START,ZVAR_HC_LOAD_END)) , 3600) / 60 ) as nvarchar),'.');
 
ZVAR_RECORDS_STATUS = CASE 
    WHEN (ZVAR_RECORD_COUNT_REMOTE - ZVAR_RECORD_COUNT) = 0  THEN 'SUCCESSFUL'
    ELSE 'FAILED'
END;
 
SELECT 	MAX("HC_PUSH_START_TIMESTAMP") INTO MAXTIME FROM "IRRBB_EVENT_LOG_TABLE_SYN" WHERE "HC_STAGE_TABLE"='IRRBB_SCB_DATA_STABLE_BALANCE_STG_T';



INSERT INTO "IRRBB_MI_EVENT_LOG_T_SYN"
(
    "W_PROCESSING_DATE",
    "W_REPORTING_DATE",
	--"W_WORKSPACE_NAME",
    "HC_STG_TABLE",
    "HC_STG_PUSH_START_TIMESTAMP",
    "HC_STG_PUSH_END_TIMESTAMP",
    "HC_STG_REC_CNT",
    "HC_STG_PROCESSING_STATUS",
    "HC_PHY_TABLE",
    "HC_PHY_LOAD_START_TIMESTAMP",
    "HC_PHY_LOAD_END_TIMESTAMP",
    "HC_PHY_REC_CNT",
    "HC_PHY_PROCESSING_STATUS"
)
SELECT
    "W_PROCESSING_DATE",
    "W_REPORTING_DATE",
	--"W_WORKSPACE_NAME",
    "HC_STAGE_TABLE",
    "HC_PUSH_START_TIMESTAMP",
    "HC_PUSH_END_TIMESTAMP",
    "HC_PUSH_REC_CNT",
    'NA',
    :ZVAR_PHY_TABLE,
    :ZVAR_HC_LOAD_START,
    :ZVAR_HC_LOAD_END,
    :ZVAR_RECORD_COUNT,
    :ZVAR_RECORDS_STATUS
    FROM  "IRRBB_EVENT_LOG_TABLE_SYN"  
    WHERE "HC_STAGE_TABLE" = 'IRRBB_SCB_DATA_STABLE_BALANCE_STG_T'
    and HC_PUSH_START_TIMESTAMP = MAXTIME; 



	
if  ZVAR_RECORD_COUNT_REMOTE != 0 then 
UPDATE "IRRBB_EVENT_LOG_TABLE_SYN"
SET "HC_PROCESSING_TIMESTAMP"=:ZVAR_HC_LOAD_START,
	"HC_FINAL_REC_CNT"= :ZVAR_RECORD_COUNT,
	"HC_PROCESSING_STATUS"=:ZVAR_RECORDS_STATUS,
	"HC_FINAL_TABLE"='IRRBB_SCB_DATA_STABLE_BALANCE_T',
	"HC_ERROR_CODE"=:SQL_ERROR_CODE,
	"HC_ERROR_MESSAGE"=:SQL_ERROR_MESSAGE
WHERE "W_PROCESSING_DATE"= CURRENT_DATE AND HC_PUSH_START_TIMESTAMP=:MAXTIME AND "HC_STAGE_TABLE"='IRRBB_SCB_DATA_STABLE_BALANCE_STG_T';
else 
UPDATE "IRRBB_EVENT_LOG_TABLE_SYN"
SET "HC_PROCESSING_TIMESTAMP"=:ZVAR_HC_LOAD_START,
	"HC_FINAL_REC_CNT"= :ZVAR_RECORD_COUNT,
	"HC_PROCESSING_STATUS"=:ZVAR_RECORDS_STATUS,
	"HC_FINAL_TABLE"='IRRBB_SCB_DATA_STABLE_BALANCE_T',
	"HC_ERROR_CODE"= 'No Records',
	"HC_ERROR_MESSAGE"= 'No Records in HIVE DB'
WHERE "W_PROCESSING_DATE"= CURRENT_DATE AND HC_PUSH_START_TIMESTAMP=:MAXTIME AND "HC_STAGE_TABLE"='IRRBB_SCB_DATA_STABLE_BALANCE_STG_T';
end if;


lt_events =
SELECT ROW_NUMBER() OVER ( ORDER BY uniq_id) AS row_num,
w_reporting_date,
w_workspace_name,
w_file_type,
hc_stage_table
FROM IRRBB_EVENT_LOG_TABLE_SYN
WHERE (hc_processing_status IS NULL   or  hc_processing_status='') and hc_push_load_status = 'SUCCESS' ;
  
--Step 2 : Get Count of rows --

Select COUNT(*) INTO lv_count from :lt_events;

---Step 3 : Mark them as In Progress --
   
UPDATE IRRBB_EVENT_LOG_TABLE_SYN
SET hc_processing_status = 'IN PROGRESS' ,
hc_processing_timestamp= CURRENT_TIMESTAMP 
WHERE (hc_processing_status IS NULL   or  hc_processing_status='') and hc_push_load_status = 'SUCCESS' ;



--Step 4: Loop 1 to total rows --

FOR i IN 1..:lv_count DO 

SELECT w_reporting_date,
w_workspace_name,
w_file_type,
hc_stage_table
INTO zvar_reporting_date,zvar_workspace_name, zvar_file_type, zvar_hc_stg_table
FROM :lt_events WHERE row_num = :i and hc_stage_table = 'IRRBB_SCB_DATA_STABLE_BALANCE_STG_T';
              
--Find procedure name for this stage 
                
--Get Mapped Procedure name 
SELECT proc_name  INTO lv_proc_name from IRRBB_METRIC_PROC_T_SYN
WHERE hc_stage_table = :zvar_hc_stg_table;  



EXECUTE IMMEDIATE 'call ' ||:lv_proc_name|| '(?);'
USING  zvar_reporting_date;   

i=:i+1;

UPDATE IRRBB_EVENT_LOG_TABLE_SYN
    SET    hc_processing_status    = 'SUCCESS',
           hc_processing_timestamp = CURRENT_TIMESTAMP
    WHERE  hc_push_load_status = 'SUCCESS'
      AND  w_reporting_date    = :zvar_reporting_date
      AND  w_workspace_name    = :zvar_workspace_name
      AND  hc_stage_table      = :zvar_hc_stg_table;

END FOR;

V_STEP = V_STEP +1;

CALL TRA_IRRBB_LOAD_LOG_PROC
( 	IP_WORKSTREAM => :V_WORKSTREAM,
	IP_METRIC => :V_METRIC,
	IP_PROC_SYSUID => :V_SYSUID,
	IP_WRAPPER_PROC_NAME => 'IRRBB_CTRLM_WRAPPER_PROC',
	IP_PROC_CTRLM_NAME => :V_PROC_NAME, 
	IP_REPORTING_DATE_START => :IP_REPORTING_DATE,
	IP_REPORTING_DATE_END => :IP_REPORTING_DATE,
	IP_ENTITY => 'NA',
	IP_ADDITIONAL_IP => 'NA',
	IP_DATA_LAYER => :V_DATA_LAYER,
	IP_SRC_TABLE =>:V_STG_TB,
	IP_TGT_TABLE =>:V_TGT_TB,
	IP_SRC_COUNT => 0,
	IP_TGT_COUNT => 0, 
	IP_ROWCOUNT => 0,
	IP_START_TIMESTAMP => :V_START_TIME,
	IP_END_TIMESTAMP => CURRENT_TIMESTAMP,
	IP_LOAD_STATUS => 	'SUCCESS',
	IP_ERROR_CODE => NULL,
	IP_ERROR_MESSAGE => NULL,
	IP_STEP_NUM => :V_STEP,
	IP_STEP_DESC =>  'Completed the execution of procedure' ||:V_PROC_NAME,
	IP_STEP_DETAILS => NULL,
	IP_IDENTIFIER => 'END',
	IP_CURRENT_USER => :V_USER);
    
CALL "IRRBB_PROC_INS_RUN_LOG"
(   'SCHEDULED>'||current_timestamp,
    'IRRBB',
    :IP_REPORTING_DATE,
    'SCHEDULED',
    'AS AND WHEN COUNTRY ARRIVES IN STARS',
    'FINAL',
    'IRRBB_MI_SCB_STABLE_BALANCE_PROC',
    'T1TREASURYIRRBB_LOG',
    'IRRBB_SCB_DATA_STABLE_BALANCE_T',
    'FACT',
    'SUCCESS',
     :ZVAR_RECORD_COUNT,
    'Completed the Execution of PROC - IRRBB_MI_SCB_STABLE_BALANCE_PROC',
     'Records Inserted into Target Table - IRRBB_MI_SCB_STABLE_BALANCE_T',
     SECONDS_BETWEEN(:ZVAR_HC_LOAD_START,CURRENT_TIMESTAMP)--:ZVAR_HC_TOTAL_LOAD_TIME
);

END;
