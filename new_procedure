        V_ERROR_CODE := ::SQL_ERROR_CODE;
        V_ERROR_MESSAGE := ::SQL_ERROR_MESSAGE;

        INSERT INTO "IRRBB_ERROR_LOG_T_SYN"
        VALUES(:ZVAR_DATAPRODUCT, :V_ERROR_CODE, :V_ERROR_MESSAGE, CURRENT_TIMESTAMP);

        IF V_PROC_STEP > 0 THEN
            CALL "TRA_IRRBB_LOAD_LOG_UPDATE_PROC"(
                IP_STEP => :V_PROC_STEP,
                IP_SYSUID => :V_SYSUID,
                IP_STATUS => 'FAILED',
                IP_ERROR_CODE => :V_ERROR_CODE,
                IP_ERROR_MESSAGE => :V_ERROR_MESSAGE,
                IP_ROW_COUNT => :V_INSERTED_COUNT,
                IP_TARGET_ROW_COUNT => :V_TARGET_COUNT
            );
        END IF;

        IF V_INSERT_STEP > 0 THEN
            CALL "TRA_IRRBB_LOAD_LOG_UPDATE_PROC"(
                IP_STEP => :V_INSERT_STEP,
                IP_SYSUID => :V_SYSUID,
                IP_STATUS => 'FAILED',
                IP_ERROR_CODE => :V_ERROR_CODE,
                IP_ERROR_MESSAGE => :V_ERROR_MESSAGE,
                IP_ROW_COUNT => :V_INSERTED_COUNT,
                IP_TARGET_ROW_COUNT => :V_TARGET_COUNT
