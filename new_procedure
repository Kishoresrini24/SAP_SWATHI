            "RISK_HELD_BY_INSURER", "SUB_TYPE", "CLEARING_HOUSE_CODE", "CHECK_ERROR_STATUS_Z",
            "CHECK_ERROR_STATUS_F", "CHECK_ERROR_STATUS_E", "ENCUMBRANCE_CODE", "CCP_EXPOSURE_TYPE",
            "WRITE_OFFS_DOWNS", "IS_SPOT", "OTTI_TAKEN_YTD", "LIQ_PRODUCT_TYPE",
            "IS_LCR_ELIGIBLE", "ELIGIBILITY_LEVEL", "SUB_ELIGIBILITY_LEVEL", "OUTSTANDING_INFLOW_RATE",
            "OUTSTANDING_OUTFLOW_RATE", "CF_INFLOW_RATE", "CF_OUTFLOW_RATE", "LCR_HAIRCUT",
            "ATTRIBUTE_10", "ATTRIBUTE_11", "ATTRIBUTE_12", "ATTRIBUTE_13",
            "ATTRIBUTE_14", "ATTRIBUTE_15", "ATTRIBUTE_16", "ATTRIBUTE_17",
            "ATTRIBUTE_18", "ATTRIBUTE_19", "ATTRIBUTE_20", "DEFERMENT_MATURITY",
            "DEFERMENT_BEGIN_TENOR", "DEFERMENT_END_TENOR", "CNTRY_CODE", "ROW_ID",
            "W_COUNTRY_CODE", "W_BATCH_ID", "W_DATASOURCE_ID", "W_REFRESH_DT",
            "W_CONTEXT_POSITION", "W_SUBPART_KEY",
            CAST("W_REPORTING_DATE" AS DATE) AS "W_REPORTING_DATE", "W_WORKSPACE_NAME"
        FROM "IRRBB_SECURITY_POSITIONS_STG_T_SYN"
        WHERE CAST(W_REPORTING_DATE AS DATE) = :IP_REPORTING_DATE
          AND W_WORKSPACE_NAME = :IP_WORKSPACE_NAME;
        --end type casting done here

        V_INSERTED_COUNT := ::ROWCOUNT;

        SELECT COUNT(*)
          INTO ZVAR_RECORD_COUNT
          FROM "IRRBB_SECURITY_POSITIONS_T_SYN"
         WHERE W_REPORTING_DATE = :IP_REPORTING_DATE
           AND W_WORKSPACE_NAME = :IP_WORKSPACE_NAME;

        V_TARGET_COUNT := ZVAR_RECORD_COUNT;

        CALL "TRA_IRRBB_LOAD_LOG_UPDATE_PROC"(
            IP_STEP => :V_INSERT_STEP,
            IP_SYSUID => :V_SYSUID,
            IP_STATUS => 'SUCCESS',
            IP_ERROR_CODE => NULL,
            IP_ERROR_MESSAGE => NULL,
            IP_ROW_COUNT => :V_INSERTED_COUNT,
            IP_TARGET_ROW_COUNT => :V_TARGET_COUNT
        );

        V_INSERT_STEP := 0;
    ELSE
        INSERT INTO "IRRBB_ERROR_LOG_T_SYN"
        VALUES(:ZVAR_DATAPRODUCT, 'NO_RECORDS', 'NO RECORDS IN STAGE TABLE', CURRENT_TIMESTAMP);
    END IF;

    SELECT COUNT(*)
      INTO ZVAR_RECORD_COUNT
      FROM "IRRBB_SECURITY_POSITIONS_T_SYN"
     WHERE W_REPORTING_DATE = :IP_REPORTING_DATE
       AND W_WORKSPACE_NAME = :IP_WORKSPACE_NAME;

    V_TARGET_COUNT := ZVAR_RECORD_COUNT;

    CALL "TRA_IRRBB_LOAD_LOG_UPDATE_PROC"(
        IP_STEP => :V_PROC_STEP,
        IP_SYSUID => :V_SYSUID,
        IP_STATUS => 'SUCCESS',
        IP_ERROR_CODE => NULL,
        IP_ERROR_MESSAGE => NULL,
        IP_ROW_COUNT => :V_INSERTED_COUNT,
        IP_TARGET_ROW_COUNT => :V_TARGET_COUNT
    );

    ZVAR_HC_LOAD_END := CURRENT_TIMESTAMP;
    V_STEP := V_STEP + 1;

    CALL "TRA_IRRBB_LOAD_LOG_PROC"(
        IP_WORKSTREAM => :V_WORKSTREAM,
        IP_METRIC => :V_METRIC,
        IP_WRAPPER_PROC_SYSUID => :IP_WRAP_PROC_SYSUUID,
        IP_PROC_SYSUID => :V_SYSUID,
        IP_WRAPPER_PROC_NAME => 'IRRBB_CTRLM_WRAPPER_PROC',
        IP_PROC_CTRLM_NAME => :V_PROC_NAME,
        IP_REPORTING_DATE_START => :IP_REPORTING_DATE,
        IP_REPORTING_DATE_END => :IP_REPORTING_DATE,
        IP_ENTITY => 'NA',
        IP_ADDITIONAL_IP => 'NA',
        IP_DATA_LAYER => :V_DATA_LAYER,
        IP_SRC_TABLE => :V_STG_TB,
        IP_TGT_TABLE => :V_TGT_TB,
        --count updated
        IP_SRC_COUNT => 0,
        IP_TGT_COUNT => 0,
        IP_ROWCOUNT => 0,
        --end count updated
        IP_START_TIMESTAMP => :V_START_TIME,
        IP_END_TIMESTAMP => :ZVAR_HC_LOAD_END,
        IP_LOAD_STATUS => 'SUCCESS',
        IP_ERROR_CODE => NULL,
        IP_ERROR_MESSAGE => NULL,
        IP_STEP_NUM => :V_STEP,
        IP_STEP_DESC => 'Completed procedure execution',
        IP_STEP_DETAILS =>
            CASE
                WHEN :V_SOURCE_COUNT = 0
                THEN 'No matching stage rows; target data preserved'
                ELSE 'Security positions records loaded'
            END,
        IP_IDENTIFIER => 'END',
        IP_CURRENT_USER => :V_USER
    );

    CALL "IRRBB_PROC_INS_RUN_LOG"(
        :V_RUN_LOG_ID,
        :V_WORKSTREAM,
        TO_NVARCHAR(:IP_REPORTING_DATE, 'YYYY-MM-DD'),
        'SCHEDULED',
        'AS AND WHEN COUNTRY ARRIVES IN STARS',
        'FINAL',
        :V_PROC_NAME,
        'T1TREASURYIRRBB_LOG',
        :V_TGT_TB,
        'FACT',
        'SUCCESS',
        :V_TARGET_COUNT,
        'Completed security positions procedure',
        CASE
            WHEN :V_SOURCE_COUNT = 0
            THEN 'No matching stage rows; target data preserved'
            ELSE 'Security positions records loaded into target'
        END,
        SECONDS_BETWEEN(:V_START_TIME, :ZVAR_HC_LOAD_END)
    );
END;
