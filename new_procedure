    DECLARE ZVAR_DATAPRODUCT NVARCHAR(5000) := 'IRRBB_SECURITY_POSITIONS';
    DECLARE ZVAR_RECORD_COUNT_REMOTE INTEGER := 0;
    DECLARE ZVAR_RECORD_COUNT INTEGER := 0;
    DECLARE ZVAR_HC_LOAD_START TIMESTAMP := CURRENT_TIMESTAMP;
    DECLARE ZVAR_HC_LOAD_END TIMESTAMP;

    DECLARE V_SOURCE_COUNT INTEGER := 0;
    DECLARE V_TARGET_COUNT INTEGER := 0;
    DECLARE V_DELETED_COUNT INTEGER := 0;
    DECLARE V_INSERTED_COUNT INTEGER := 0;

    DECLARE V_SYSUID NVARCHAR(150) := TO_VARCHAR(SYSUUID);
    DECLARE V_START_TIME TIMESTAMP := CURRENT_TIMESTAMP;
    DECLARE V_PROC_NAME NVARCHAR(100) := ::CURRENT_OBJECT_NAME;
    DECLARE V_STG_TB NVARCHAR(150) := 'IRRBB_SECURITY_POSITIONS_STG_T';
    DECLARE V_TGT_TB NVARCHAR(150) := 'IRRBB_SECURITY_POSITIONS_T';
    DECLARE V_WORKSTREAM NVARCHAR(13) := 'IRRBB';
    DECLARE V_METRIC NVARCHAR(150) := 'IRRBB_MI_SECURITY_POSITIONS';
    DECLARE V_USER NVARCHAR(150) := CURRENT_USER;
    DECLARE V_DATA_LAYER NVARCHAR(100) := 'AGG';
